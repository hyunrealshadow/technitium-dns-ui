  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hash": "tsc -b && vite build --mode hash",
    "build:history": "tsc -b && vite build --mode history",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" vite.config.ts"
  },
